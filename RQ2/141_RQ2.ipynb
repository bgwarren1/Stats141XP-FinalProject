      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Setup and Melt the Data\n",
        "df = pd.read_csv('dat_withSentiment.csv')\n",
        "df_plot = df.dropna(subset=['ethnicity', 'gender'])\n",
        "\n",
        "sentiment_cols = [\n",
        "    'scenario_1_reason_sentiment', 'scenario_2_reason_sentiment', \n",
        "    'scenario_3_reason_sentiment', 'scenario_4_reason_sentiment', \n",
        "    'scenario_5_reason_sentiment'\n",
        "]\n",
        "\n",
        "# Melting the data transforms it so we can group by Scenario\n",
        "df_long = pd.melt(\n",
        "    df_plot, \n",
        "    id_vars=['ethnicity', 'gender'], \n",
        "    value_vars=sentiment_cols,\n",
        "    var_name='Scenario', \n",
        "    value_name='Sentiment_Score'\n",
        ")\n",
        "\n",
        "# Clean up scenario names so they look pretty on the axis\n",
        "df_long['Scenario'] = df_long['Scenario'].str.replace('_reason_sentiment', '').str.replace('_', ' ').str.title()\n",
        "\n",
        "# 2. Plotting\n",
        "sns.set_theme(style=\"whitegrid\", font_scale=1.2)\n",
        "fig, axes = plt.subplots(2, 1, figsize=(16, 12)) # Taller figure to fit the breakdown\n",
        "\n",
        "# Subplot A: By Ethnicity\n",
        "sns.barplot(\n",
        "    data=df_long, \n",
        "    x='Scenario', \n",
        "    y='Sentiment_Score', \n",
        "    hue='ethnicity', \n",
        "    ax=axes[0], \n",
        "    palette='viridis',\n",
        "    errorbar='ci', capsize=0.05\n",
        ")\n",
        "axes[0].set_title('Average Reasoning Sentiment per Scenario by Race/Ethnicity', fontsize=16, weight='bold', pad=15)\n",
        "axes[0].set_ylabel('Average Sentiment Score (-1 to 1)', fontsize=14)\n",
        "axes[0].set_xlabel('')\n",
        "axes[0].legend(title='Race/Ethnicity', bbox_to_anchor=(1.02, 1), loc='upper left')\n",
        "\n",
        "# Subplot B: By Gender\n",
        "sns.barplot(\n",
        "    data=df_long[df_long['gender'] != 'Prefer not to Say'], \n",
        "    x='Scenario', \n",
        "    y='Sentiment_Score', \n",
        "    hue='gender', \n",
        "    ax=axes[1], \n",
        "    palette='viridis',\n",
        "    errorbar='ci', capsize=0.05\n",
        ")\n",
        "axes[1].set_title('Average Reasoning Sentiment per Scenario by Gender', fontsize=16, weight='bold', pad=15)\n",
        "axes[1].set_ylabel('Average Sentiment Score (-1 to 1)', fontsize=14)\n",
        "axes[1].set_xlabel('')\n",
        "axes[1].legend(title='Gender', bbox_to_anchor=(1.02, 1), loc='upper left')\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "# SAVE FIRST, THEN SHOW\n",
        "plt.savefig('scenario_sentiment_breakdown.png', dpi=300, bbox_inches='tight')\n",
        "plt.show()"
      ]
    }
